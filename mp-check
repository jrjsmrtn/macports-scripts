#!/usr/bin/env python3
"""Run mp-check from a plain checkout.

The implementation lives in macports_scripts/mp_check.py, which pyproject.toml
installs as the `mp-check` console script. This wrapper exists so the `mp`
dispatcher keeps working without `poetry install`, and so there is only one copy
of the code: the two diverged for three commits and the standalone copy carried
a bug the packaged one did not.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from macports_scripts.mp_check import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
