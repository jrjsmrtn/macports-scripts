grammar = Grammar(
    r"""
    checksums = 'checksums' _ pchecksum+
    pchecksum = fname _ fchecksum+ _ fsize _
    fname = ~r'[\w\.\+-]+'
    fchecksum = type _ checksum _
    type = ('rmd160' / 'sha256')
    checksum = ~'[0-9A-Za-z]+'
    fsize = 'size' _ size
    size = ~r'\d+'

    _ = meaninglessness*
    meaninglessness = ~r"\s+" / comment / continuation
    comment = ~r"#[^\r\n]*"
    continuation = ~r'\\\n'
    """
)

crates_grammar = Grammar(
    r"""
    crates = 'cargo.crates' _ cchecksum+
    cchecksum = cname _ cversion _ checksum _
    """
)


class ChecksumsVisitor(NodeVisitor):
    def visit_checksums(self, node, visited_children):
        """Return the overall output."""
        return visited_children[-1]

    def visit_pchecksum(self, node, visited_children):
        fname, _, checksums, _, size, *_ = visited_children
        return {fname: {"checksums": checksums, "size": size}}

    def visit_fchecksum(self, node, visited_children):
        type_, _, checksum, *_ = visited_children
        return {type_: checksum}

    def visit_fname(self, node, visisted_children):
        return node.text

    def visit_checksum(self, node, visisted_children):
        return node.text

    def visit_type(self, node, visited_children):
        return node.text

    def visit_fsize(self, node, visited_children):
        return visited_children[-1]

    def visit_size(self, node, visited_children):
        return int(node.text)

    def generic_visit(self, node, visited_children):
        """Visit node."""
        return visited_children or node


CRATENAME_RE: re.Pattern = re.compile(
    r"^(?P<name>.+?)-(?P<version>\d+\.\d+\.\d+[^\.]*)\.crate$"
)


class GroupedChecksumsVisitor(ChecksumsVisitor):
    files: ClassVar[dict[str, str]] = {}
    crates: ClassVar[dict[str, str]]  = {}

    def visit_checksums(self, node, visited_children) -> dict:
        """Return the overall output."""
        return {"files": self.files, "crates": self.crates}

    def visit_pchecksum(self, node, visited_children):
        fname, _, checksums, _, size, *_ = visited_children
        props = {"checksums": checksums, "size": size}
        if match := CRATENAME_RE.match(fname):
            props.update(match.groupdict())
            self.crates[fname] = props
        else:
            self.files[fname] = props


